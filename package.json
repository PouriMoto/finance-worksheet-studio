{
  "name": "financial-city",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run sync:media && npm run dev -w @hormat/web",
    "build": "npm run validate && npm run lint:i18n && npm run sync:media && npm run build -w @hormat/web",
    "preview": "npm run preview -w @hormat/web",
    "validate": "tsx packages/content/src/cli.ts validate",
    "lint:i18n": "tsx packages/content/src/cli.ts lint-i18n",
    "new": "tsx packages/content/src/cli.ts new",
    "test": "tsx --test packages/content/test/*.test.ts packages/engine/test/*.test.ts packages/engine/test/*.test.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "add-part": "tsx packages/content/src/cli.ts add-part",
    "migrate": "tsx packages/content/src/cli.ts migrate",
    "sync:media": "node tools/sync-media.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}